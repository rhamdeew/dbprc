# Local development. `make dev` sources this file.
# mockoidc listens on 127.0.0.1:9999. Its issuer includes /oidc
# (discovery: $OIDC_ISSUER/.well-known/openid-configuration).
# The API does not read OIDC_* until the auth card. The client id and secret
# are the fixed fake client in backend/cmd/mockoidc, not a real Google app.
OIDC_ISSUER=http://localhost:9999/oidc
OIDC_CLIENT_ID=arc-dev
OIDC_CLIENT_SECRET=arc-dev-secret
ALLOWED_DOMAIN=example.com
