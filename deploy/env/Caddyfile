# Per-environment web server: Basic Auth, static frontend, uploads, API proxy.
# TLS is terminated by the edge Caddy (/opt/arc-edge); this listens on plain HTTP.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	@protected not path /healthz
	basic_auth @protected {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	handle /healthz {
		reverse_proxy api:8080
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /auth/* {
		reverse_proxy api:8080
	}
	handle /ws {
		reverse_proxy api:8080
	}
	handle_path /uploads/* {
		root * /uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
