# Per-environment web server: Basic Auth, static frontend, uploads, API proxy.
# TLS is terminated by the edge Caddy (/opt/arc-edge); this listens on plain HTTP.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# /healthz stays open for the deploy smoke test and uptime monitors.
	# /ws is open too: browsers do not reliably send Basic Auth on a WebSocket
	# handshake (Safari does not). The API still refuses the upgrade without a
	# session cookie, which is only handed out behind Basic Auth on /auth/*,
	# and without the app's own Origin.
	@protected not path /healthz /ws
	basic_auth @protected {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://{host}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	handle /healthz {
		reverse_proxy api:8080
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /auth/* {
		reverse_proxy api:8080
	}
	handle /ws {
		reverse_proxy api:8080
	}
	handle_path /uploads/* {
		root * /uploads
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Disposition "inline"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
